#!/usr/bin/env bash
# agentflow commit-msg hook (generated by `agentflow init`; commit it).
# Enable once per clone:  git config core.hooksPath .githooks
#
# Uses the installed agentflow when available (full rules from .agentflow/config.yml).
# Never triggers a download during a commit: without agentflow it falls back to a
# built-in check of the subject line. The PR check in CI is the real gate.
set -euo pipefail
msg_file="$1"

cache="${XDG_CACHE_HOME:-$HOME/.cache}/agentflow/current/agentflow"
if [ -x "$cache" ]; then
  exec "$cache" hook commit-msg "$msg_file"
elif command -v agentflow >/dev/null 2>&1; then
  exec agentflow hook commit-msg "$msg_file"
fi

subject=$(head -n1 "$msg_file")
case "$subject" in
  Merge*|Revert*|fixup!*|squash!*|amend!*) exit 0 ;;
esac

types='feat|fix|perf|refactor|docs|test|build|ci|chore|revert'
key='[A-Z][A-Z0-9]+-[0-9]+'
pattern="^($types)\\(($key)(,$key)*\\)!?: .+"
example="feat(PLAT-123): add quota API"
# commit.require_key: false in .agentflow/config.yml makes the Jira key optional.
config="$(git rev-parse --show-toplevel)/.agentflow/config.yml"
if [ -f "$config" ] && grep -Eq '^[[:space:]]*require_key:[[:space:]]*false' "$config"; then
  pattern="^($types)(\\([^()]+\\))?!?: .+"
  example="feat(api): add quota API"
fi

if ! [[ "$subject" =~ $pattern ]]; then
  echo "✖ Commit subject must look like: $example" >&2
  echo "  got: $subject" >&2
  exit 1
fi
if [ "${#subject}" -gt 72 ]; then
  echo "✖ Commit subject is ${#subject} characters; keep it under 72" >&2
  exit 1
fi
