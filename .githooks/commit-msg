#!/usr/bin/env bash
# agentflow repo's own commit-msg hook: checks the message with the agentflow built from this
# checkout, using the rules in .agentflow/config.yml. Enable with: make install-hooks
set -euo pipefail
root=$(git rev-parse --show-toplevel)
export AGENTFLOW_NO_UPDATE=1
if [ -x "$root/agentflow" ]; then
  exec "$root/agentflow" hook commit-msg "$1"
fi
exec go run "$root/cmd/agentflow" hook commit-msg "$1"
