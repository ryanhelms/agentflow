#!/usr/bin/env bash
# devflow commit-msg hook (generated by `devflow init`; commit it).
# Enable once per clone:  git config core.hooksPath .githooks
#
# Uses the installed devflow when available (full rules from .devflow/config.yml).
# Never triggers a download during a commit: without devflow it falls back to a
# built-in check of the subject line. The PR check in CI is the real gate.
set -euo pipefail
msg_file="$1"

cache="${XDG_CACHE_HOME:-$HOME/.cache}/devflow/current/devflow"
if [ -x "$cache" ]; then
  exec "$cache" hook commit-msg "$msg_file"
elif command -v devflow >/dev/null 2>&1; then
  exec devflow hook commit-msg "$msg_file"
fi

subject=$(head -n1 "$msg_file")
case "$subject" in
  Merge*|Revert*|fixup!*|squash!*|amend!*) exit 0 ;;
esac

types='feat|fix|perf|refactor|docs|test|build|ci|chore|revert'
key='[A-Z][A-Z0-9]+-[0-9]+'
pattern="^($types)\\(($key)(,$key)*\\)!?: .+"

if ! [[ "$subject" =~ $pattern ]]; then
  echo "✖ Commit subject must look like: feat(PLAT-123): add quota API" >&2
  echo "  got: $subject" >&2
  exit 1
fi
if [ "${#subject}" -gt 72 ]; then
  echo "✖ Commit subject is ${#subject} characters; keep it under 72" >&2
  exit 1
fi
