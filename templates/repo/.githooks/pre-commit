#!/usr/bin/env bash
# agentflow pre-commit hook (generated by `agentflow init`; commit it).
# Enable once per clone:  git config core.hooksPath .githooks
#
# Refuses commits in the primary checkout: every task gets its own linked worktree.
# AGENTFLOW_ALLOW_PRIMARY=1 bypasses the check, for example to commit `agentflow init`.
set -euo pipefail

[ "${AGENTFLOW_ALLOW_PRIMARY:-}" = 1 ] && exit 0
# A repository without commits yet has nothing to branch a worktree from.
git rev-parse --verify --quiet HEAD >/dev/null || exit 0

git_dir=$(cd "$(git rev-parse --git-dir)" && pwd -P)
common_dir=$(cd "$(git rev-parse --git-common-dir)" && pwd -P)
if [ "$git_dir" = "$common_dir" ]; then
  echo "✖ agentflow: this is the primary checkout; commit in a task worktree instead." >&2
  echo "  Run: agentflow start <issue> --worktree   then work in the directory it prints." >&2
  echo "  To commit here anyway: AGENTFLOW_ALLOW_PRIMARY=1 git commit ..." >&2
  exit 1
fi
