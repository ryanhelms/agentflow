#!/usr/bin/env bash
# agentflow pre-commit hook (generated by `agentflow init`; commit it).
# Enable once per clone:  git config core.hooksPath .githooks
#
# Refuses commits in the primary checkout: every task gets its own linked worktree.
# AGENTFLOW_ALLOW_PRIMARY=1 bypasses the check, for example to commit `agentflow init`.
# Also refuses a commit from an agent session that belongs to another repository
# (AGENTFLOW_SESSION_REPO, set by agentflow for each session; see docs/repo-boundary.md).
set -euo pipefail

if [ -n "${AGENTFLOW_SESSION_REPO:-}" ] && [ -d "$AGENTFLOW_SESSION_REPO" ]; then
  here=$(cd "$(git rev-parse --git-common-dir)" && pwd -P)
  session=$(cd "$(git -C "$AGENTFLOW_SESSION_REPO" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || echo "$AGENTFLOW_SESSION_REPO")" && pwd -P)
  if [ "$here" != "$session" ]; then
    echo "✖ agentflow: this session belongs to the repository at $session, not this one." >&2
    echo "  A session changes only its own repository. Hand this work to a session here:" >&2
    echo "  agentflow delegate --repo $(basename "$(dirname "$here")") \"<task>\"" >&2
    echo "  A person in a shell that inherited the variable can run: unset AGENTFLOW_SESSION_REPO" >&2
    exit 1
  fi
fi

[ "${AGENTFLOW_ALLOW_PRIMARY:-}" = 1 ] && exit 0
# A repository without commits yet has nothing to branch a worktree from.
git rev-parse --verify --quiet HEAD >/dev/null || exit 0

git_dir=$(cd "$(git rev-parse --git-dir)" && pwd -P)
common_dir=$(cd "$(git rev-parse --git-common-dir)" && pwd -P)
if [ "$git_dir" = "$common_dir" ]; then
  echo "✖ agentflow: this is the primary checkout; commit in a task worktree instead." >&2
  echo "  Run: agentflow start <issue> --worktree   then work in the directory it prints." >&2
  echo "  To commit here anyway: AGENTFLOW_ALLOW_PRIMARY=1 git commit ..." >&2
  exit 1
fi
