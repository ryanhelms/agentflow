#!/usr/bin/env bash
# agentflow pre-push hook (generated by `agentflow init`; commit it).
# Enable once per clone:  git config core.hooksPath .githooks
#
# Blocks pushes to the branches in policy.protected_branches of .agentflow/config.yml
# (default main, master, develop, release/*). Work reaches them through pull requests.
# AGENTFLOW_ALLOW_PROMOTE=1 allows a push to main or master for a release promotion only.
set -euo pipefail

cache="${XDG_CACHE_HOME:-$HOME/.cache}/agentflow/current/agentflow"
if [ -x "$cache" ]; then
  exec "$cache" hook pre-push "$@"
elif command -v agentflow >/dev/null 2>&1; then
  exec agentflow hook pre-push "$@"
fi

# Fallback without agentflow. Refuse a push from an agent session that belongs to
# another repository (AGENTFLOW_SESSION_REPO; see docs/repo-boundary.md).
if [ -n "${AGENTFLOW_SESSION_REPO:-}" ] && [ -d "$AGENTFLOW_SESSION_REPO" ]; then
  here=$(cd "$(git rev-parse --git-common-dir)" && pwd -P)
  session=$(cd "$(git -C "$AGENTFLOW_SESSION_REPO" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || echo "$AGENTFLOW_SESSION_REPO")" && pwd -P)
  if [ "$here" != "$session" ]; then
    echo "✖ agentflow: this session belongs to the repository at $session, not this one; hand the work to a session here with agentflow delegate" >&2
    exit 1
  fi
fi

# Read protected_branches from the config.
config="$(git rev-parse --show-toplevel)/.agentflow/config.yml"
protected=()
if [ -f "$config" ]; then
  in_list=0
  while IFS= read -r line; do
    [[ "$line" =~ ^[[:space:]]*# ]] && continue
    case "$line" in
      *protected_branches:*\[*)
        list=${line#*[}
        list=${list%%]*}
        IFS=',' read -r -a items <<<"$list"
        for item in ${items[@]+"${items[@]}"}; do
          item=$(printf '%s' "$item" | tr -d " \"'")
          [ -n "$item" ] && protected+=("$item")
        done
        ;;
      *protected_branches:*) in_list=1 ;;
      *)
        if [ "$in_list" = 1 ]; then
          if [[ "$line" =~ ^[[:space:]]*-[[:space:]]*(.+)$ ]]; then
            item=$(printf '%s' "${BASH_REMATCH[1]}" | tr -d " \"'")
            [ -n "$item" ] && protected+=("$item")
          else
            in_list=0
          fi
        fi
        ;;
    esac
  done <"$config"
fi
if [ "${#protected[@]}" -eq 0 ]; then
  protected=(main master develop 'release/*')
fi

status=0
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  branch=${remote_ref#refs/heads/}
  for pattern in "${protected[@]}"; do
    # shellcheck disable=SC2053 # the pattern is a glob on purpose
    if [[ "$branch" == $pattern ]]; then
      if [ "${AGENTFLOW_ALLOW_PROMOTE:-}" = 1 ] && { [ "$branch" = main ] || [ "$branch" = master ]; }; then
        continue
      fi
      echo "✖ agentflow: pushing to protected branch $branch is blocked; push a feature branch and open a PR" >&2
      status=1
    fi
  done
done
exit "$status"
