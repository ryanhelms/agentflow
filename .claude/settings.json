{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Edit(/CLAUDE.md)",
      "Edit(/**/CLAUDE.md)",
      "Write(/CLAUDE.md)",
      "Write(/**/CLAUDE.md)",
      "Edit(/CHANGELOG.md)",
      "Write(/CHANGELOG.md)"
    ]
  },
  "includeCoAuthoredBy": false,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.githooks/claude-pre-bash",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
