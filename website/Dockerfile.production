FROM node:24-slim AS build
WORKDIR /source/website
COPY website/package.json website/package-lock.json ./
COPY website/vendor ./vendor
RUN --mount=type=cache,target=/root/.npm npm ci --no-audit --no-fund
COPY website/vite.config.js website/content.mjs ./
COPY website/src ./src
COPY docs /source/docs
COPY README.md CONTRIBUTING.md CHANGELOG.md SECURITY.md /source/
ARG AGENTFLOW_SITE_REPOSITORY
ARG AGENTFLOW_SITE_DOCS_REF
ARG AGENTFLOW_SITE_RELEASE
ARG AGENTFLOW_SITE_RELEASE_SHA
RUN npm run build

FROM nginxinc/nginx-unprivileged:stable-alpine
COPY website/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /source/website/dist /usr/share/nginx/html
EXPOSE 8080
