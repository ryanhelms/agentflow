#!/bin/sh
# Claude Code plugin launcher for the MCP server and hooks. Prefers the repo's launcher,
# then the installed binary, then bootstraps the latest verified release through the
# plugin's own bin/devflow, so the plugin works (and can run `devflow init`) in repos that
# devflow has not set up yet.
set -eu

root=$(git rev-parse --show-toplevel 2>/dev/null || true)
if [ -n "$root" ] && [ -x "$root/.devflow/bin/devflow" ]; then
  exec "$root/.devflow/bin/devflow" "$@"
fi

installed="${XDG_CACHE_HOME:-$HOME/.cache}/devflow/current/devflow"
if [ -x "$installed" ]; then
  exec "$installed" "$@"
fi

# pre-bash and stop run on every tool call and turn: never download there, and never
# break a session.
case "${1:-} ${2:-}" in
  "hook pre-bash" | "hook stop") exit 0 ;;
esac

here=$(cd "$(dirname "$0")" && pwd)
if [ "${1:-}" = hook ]; then
  # session-start may bootstrap, but must not fail the session if that fails
  "$here/devflow" "$@" || true
  exit 0
fi
exec "$here/devflow" "$@"
