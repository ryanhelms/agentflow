#!/bin/sh
# devflow launcher shipped with the Claude Code plugin (a copy of the project launcher
# that `devflow init` writes to .devflow/bin/devflow; a test keeps them identical below
# this header). Claude Code puts the plugin's bin/ on the Bash PATH, so `devflow` works
# in any repo, including one that devflow has not set up yet.
# Runs the installed devflow, or bootstraps the latest stable release on first use.
# After that the binary updates itself in the background. Progress goes to stderr so
# MCP stdout stays clean.
set -eu

home="${XDG_CACHE_HOME:-$HOME/.cache}/devflow"
if [ -x "$home/current/devflow" ]; then
  exec "$home/current/devflow" "$@"
fi

command -v gh >/dev/null 2>&1 || {
  echo "devflow: first run needs the GitHub CLI (gh) logged in to github.com" >&2
  exit 1
}

os=$(uname -s | tr '[:upper:]' '[:lower:]')
case "$(uname -m)" in
  x86_64|amd64) arch=amd64 ;;
  arm64|aarch64) arch=arm64 ;;
  *) echo "devflow: unsupported architecture $(uname -m)" >&2; exit 1 ;;
esac

tag=$(gh release view --repo nscaledev/devflow --json tagName -q .tagName)
ver=${tag#v}
pkg="devflow_${ver}_${os}_${arch}.tar.gz"
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT INT TERM

echo "devflow: first run, installing $tag" >&2
gh release download "$tag" --repo nscaledev/devflow --dir "$tmp" \
  --pattern "$pkg" --pattern checksums.txt >&2

if command -v sha256sum >/dev/null 2>&1; then sum="sha256sum"; else sum="shasum -a 256"; fi
(cd "$tmp" && grep " $pkg\$" checksums.txt | $sum -c -) >&2 || {
  echo "devflow: checksum mismatch for $pkg, not installing" >&2
  exit 1
}
gh attestation verify "$tmp/$pkg" --repo nscaledev/devflow >&2 || {
  echo "devflow: build attestation did not verify, not installing" >&2
  exit 1
}

mkdir -p "$home/$ver"
tar -xzf "$tmp/$pkg" -C "$home/$ver" devflow
ln -sfn "$home/$ver" "$home/current"
exec "$home/current/devflow" "$@"
